{
  "private": true,
  "name": "timetracker",
  "description": "Timetracker app",
  "version": "1.54.0-beta.1",
  "author": "mmmykhailo <mmmykhailo@proton.me>",
  "main": "main/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "coverage": "jest --coverage",
    "test": "jest",
    "clean": "rimraf dist main renderer/dist app",
    "postinstall": "electron-builder install-app-deps",
    "dev": "npm run build-electron && concurrently -k -r \"npm run build-electron:watch\" \"npm run vite:dev\" \"npm run electron:dev\"",
    "dev:once": "npm run build-electron && electron .",
    "vite:dev": "vite --config renderer/vite.config.mts",
    "build-renderer": "vite build --config renderer/vite.config.mts",
    "build-electron": "tsc -p electron-src",
    "build-electron:watch": "tsc -w -p electron-src --preserveWatchOutput",
    "electron:dev": "wait-on http://127.0.0.1:3000 && electron .",
    "electron:watch": "wait-on http://127.0.0.1:3000 && nodemon --watch main --ext js,json --delay 2 --exec electron .",
    "build": "npm run build-renderer && npm run build-electron",
    "pack-app": "npm run clean && npm run build && electron-builder --dir",
    "dist": "npm run clean && npm run build && electron-builder",
    "dist:all": "npm run clean && npm run build && electron-builder --win --mac --linux",
    "dist-win": "npm run clean && npm run build && electron-builder --win",
    "dist-macos": "npm run clean && npm run build && electron-builder --mac",
    "dist-linux": "npm run clean && npm run build && electron-builder --linux",
    "dist-win:x64": "npm run clean && npm run build && electron-builder --win --x64",
    "dist-win:ia32": "npm run clean && npm run build && electron-builder --win --ia32",
    "dist-win:arm64": "npm run clean && npm run build && electron-builder --win --arm64",
    "dist-macos:x64": "npm run clean && npm run build && electron-builder --mac --x64",
    "dist-macos:arm64": "npm run clean && npm run build && electron-builder --mac --arm64",
    "dist-macos:universal": "npm run clean && npm run build && electron-builder --mac --universal",
    "dist-linux:x64": "npm run clean && npm run build && electron-builder --linux --x64",
    "dist-linux:arm64": "npm run clean && npm run build && electron-builder --linux --arm64",
    "build-client": "node scripts/build-client.js",
    "build-client:win32": "electron-builder --win",
    "build-client:darwin": "npm list -g dmg-license || sudo npm i -g dmg-license && electron-builder --mac",
    "build-client:linux": "electron-builder --linux",
    "type-check": "tsc -p ./renderer/tsconfig.json && tsc -p ./electron-src/tsconfig.json",
    "format": "prettier --write \"./renderer/src/**/*.{ts,tsx}\"",
    "lint": "eslint \"./renderer/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"./renderer/src/**/*.{ts,tsx}\" --fix"
  },
  "lint-staged": {
    "./renderer/src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "repository": "https://github.com/ukad-group/timetracker-desktop-client",
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.timetracker.autoupdater",
    "productName": "Timetracker",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main",
      "renderer/.env",
      "renderer/dist/**/*",
      "!renderer/src/**/*",
      "!renderer/node_modules/**/*",
      "!**/*.map",
      "!**/node_modules/*/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "deb",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "differentialPackage": true
    }
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "@floating-ui/dom": "^1.8.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@headlessui/react": "^2.2.10",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "semver": "^7.8.5",
    "serve-handler": "^6.1.7",
    "slate": "^0.126.2",
    "slate-history": "^0.113.1",
    "slate-react": "^0.126.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-date-mock": "^1.0.10",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  }
}
