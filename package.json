{
  "private": true,
  "name": "timetracker",
  "description": "Timetracker app",
  "version": "1.53.0-beta.11",
  "author": "mmmykhailo <mmmykhailo@proton.me>",
  "main": "main/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "coverage": "jest --coverage",
    "test": "jest",
    "clean": "rimraf dist main renderer/out renderer/.next",
    "postinstall": "electron-builder install-app-deps",
    "dev": "npm run build-electron && electron .",
    "build-renderer": "next build renderer",
    "build-electron": "tsc -p electron-src",
    "build": "npm run build-renderer && npm run build-electron",
    "pack-app": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist-win": "npm run build && electron-builder --win",
    "dist-macos": "npm run build && electron-builder  --macos",
    "build-client": "run-script-os",
    "build-client:win32": "electron-builder --win",
    "build-client:darwin": "npm list -g dmg-license || sudo npm i -g dmg-license && electron-builder --mac",
    "type-check": "tsc -p ./renderer/tsconfig.json && tsc -p ./electron-src/tsconfig.json",
    "format": "prettier --write \"./renderer/src/**/*.{ts,tsx}\"",
    "lint": "eslint \"./renderer/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"./renderer/src/**/*.{ts,tsx}\" --fix",
    "prepare": "husky install"
  },
  "lint-staged": {
    "./renderer/src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "repository": "https://github.com/ukad-group/timetracker-desktop-client",
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.timetracker.autoupdater",
    "productName": "Timetracker",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "main",
      "renderer"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "win": {
      "target": "nsis",
      "icon": "app/images/logo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "app/images/logo.png"
    },
    "linux": {
      "target": "deb",
      "icon": "app/images/logo.png"
    }
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/react": "^0.27.16",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@headlessui/react": "^1.7.19",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "chokidar": "^3.6.0",
    "clsx": "^1.2.1",
    "electron-is-dev": "^1.2.0",
    "electron-next": "^3.1.5",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.7.3",
    "husky": "^9.1.7",
    "is-online": "^10.0.0",
    "next": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "slate": "^0.120.0",
    "slate-history": "^0.115.0",
    "slate-react": "^0.120.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^14.18.63",
    "@types/react": "^16.14.68",
    "@types/react-dom": "^16.9.25",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.23",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "jest-date-mock": "^1.0.10",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react-test-renderer": "^18.3.1",
    "rimraf": "^3.0.2",
    "run-script-os": "^1.1.6",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "typescript": "^5.6.3"
  }
}
