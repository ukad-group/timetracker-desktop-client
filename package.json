{
  "private": true,
  "name": "timetracker",
  "description": "Timetracker app",
  "version": "1.53.0-beta.11",
  "author": "mmmykhailo <mmmykhailo@proton.me>",
  "main": "main/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "coverage": "jest --coverage",
    "test": "jest",
    "clean": "rimraf dist main renderer/out renderer/.next",
    "postinstall": "electron-builder install-app-deps",
    "dev": "npm run build-electron && electron .",
    "build-renderer": "next build renderer",
    "build-electron": "tsc -p electron-src",
    "build": "npm run build-renderer && npm run build-electron",
    "pack-app": "npm run clean && npm run build && electron-builder --dir",
    "dist": "npm run clean && npm run build && electron-builder",
    "dist:all": "npm run clean && npm run build && electron-builder --win --mac --linux",
    "dist-win": "npm run clean && npm run build && electron-builder --win",
    "dist-macos": "npm run clean && npm run build && electron-builder --mac",
    "dist-linux": "npm run clean && npm run build && electron-builder --linux",
    "dist-win:x64": "npm run clean && npm run build && electron-builder --win --x64",
    "dist-win:ia32": "npm run clean && npm run build && electron-builder --win --ia32",
    "dist-win:arm64": "npm run clean && npm run build && electron-builder --win --arm64",
    "dist-macos:x64": "npm run clean && npm run build && electron-builder --mac --x64",
    "dist-macos:arm64": "npm run clean && npm run build && electron-builder --mac --arm64",
    "dist-macos:universal": "npm run clean && npm run build && electron-builder --mac --universal",
    "dist-linux:x64": "npm run clean && npm run build && electron-builder --linux --x64",
    "dist-linux:arm64": "npm run clean && npm run build && electron-builder --linux --arm64",
    "build-client": "node scripts/build-client.js",
    "build-client:win32": "electron-builder --win",
    "build-client:darwin": "npm list -g dmg-license || sudo npm i -g dmg-license && electron-builder --mac",
    "build-client:linux": "electron-builder --linux",
    "type-check": "tsc -p ./renderer/tsconfig.json && tsc -p ./electron-src/tsconfig.json",
    "format": "prettier --write \"./renderer/src/**/*.{ts,tsx}\"",
    "lint": "eslint \"./renderer/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"./renderer/src/**/*.{ts,tsx}\" --fix"
  },
  "lint-staged": {
    "./renderer/src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "repository": "https://github.com/ukad-group/timetracker-desktop-client",
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.timetracker.autoupdater",
    "productName": "Timetracker",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "main",
      "renderer/out/**/*",
      "!renderer/.next/**/*",
      "!renderer/src/**/*",
      "!renderer/node_modules/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "win": {
      "target": "nsis",
      "icon": "app/images/logo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "app/images/logo.png"
    },
    "linux": {
      "target": "deb",
      "icon": "app/images/logo.png"
    }
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/react": "^0.27.16",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@headlessui/react": "^2.2.9",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "electron-is-dev": "^3.0.1",
    "electron-next": "^3.1.5",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.7.3",
    "husky": "^9.1.7",
    "is-online": "^12.0.2",
    "next": "^16.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "slate": "^0.120.0",
    "slate-history": "^0.115.0",
    "slate-react": "^0.120.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "autoprefixer": "^10.4.23",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "jest-date-mock": "^1.0.10",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react-test-renderer": "^19.2.3",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
