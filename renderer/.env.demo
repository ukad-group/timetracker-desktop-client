# COMMON VARIABLES
# NEXT_PUBLIC_PORT= // will be defined after server started
# Use literal values — dotenv does not expand ${VAR} references.

NEXT_PUBLIC_PORT_REPLACE_TOKEN_NAME=PORT_TOKEN_NAME
NEXT_PUBLIC_SERVER_ADDRESS=http://localhost:PORT_TOKEN_NAME
NEXT_PUBLIC_PROTOCOL=time-tracker
NEXT_PUBLIC_PROTOCOL_SERVER_ADDRESS=time-tracker://localhost

# TRELLO VARIABLES
NEXT_PUBLIC_TRELLO_KEY=
NEXT_PUBLIC_TRELLO_REDIRECT_URI=time-tracker://localhost/settings

# GOOGLE VARIABLES
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=

# OFFICE365 VARIABLES
NEXT_PUBLIC_OFFICE365_CLIENT_ID=
NEXT_PUBLIC_OFFICE365_CLIENT_SECRET=
NEXT_PUBLIC_OFFICE365_REDIRECT_URI=
NEXT_PUBLIC_OFFICE365_SCOPE=

# JIRA VARIABLES
NEXT_PUBLIC_JIRA_CLIENT_ID=
NEXT_PUBLIC_JIRA_CLIENT_SECRET=
NEXT_PUBLIC_JIRA_REDIRECT_URI=time-tracker://localhost/settings
NEXT_PUBLIC_JIRA_SCOPE=
