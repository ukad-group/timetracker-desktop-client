    value: "testValue",
    required: false,
    tabIndex: 0,
  };

  it("renders without errors", () => {
    render(<TextField {...defaultProps} />);
    expect(screen.getByLabelText("Test Label")).toBeInTheDocument();
    expect(screen.getByTestId("text-field-test-id")).toBeInTheDocument();
  });

